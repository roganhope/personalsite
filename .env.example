# PostHog (public — shipped to the browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# /secret/admin login password.
ADMIN_PASSWORD=

# Signs the admin session cookie. Rotate freely — it just logs every
# device out.
SESSION_SECRET=

# Encrypts /go/p sneaky link tokens. Do NOT rotate casually: every link
# already sitting in a sent email or chat silently turns into an untracked
# redirect to the homepage.
LINK_SECRET=

# Reads link_click back out of PostHog for the admin panel's usage table.
# Server-only — distinct from the public project token above, which only
# writes. Without these the panel still mints links; the table just says so.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
